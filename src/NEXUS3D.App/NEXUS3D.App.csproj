    <ProjectReference Include="..\NEXUS3D.Domain\NEXUS3D.Domain.csproj" />
    <ProjectReference Include="..\NEXUS3D.Formats.Abstractions\NEXUS3D.Formats.Abstractions.csproj" />
    <ProjectReference Include="..\NEXUS3D.Engine\NEXUS3D.Engine.csproj" />
    <ProjectReference Include="..\NEXUS3D.Rendering\NEXUS3D.Rendering.csproj" />
    <ProjectReference Include="..\NEXUS3D.PluginSystem\NEXUS3D.PluginSystem.csproj" />
    <ProjectReference Include="..\NEXUS3D.Shared\NEXUS3D.Shared.csproj" />
  </ItemGroup>

</Project>
