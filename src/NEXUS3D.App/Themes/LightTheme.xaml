<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================================================================= -->
    <!-- NEXUS-3D OFFICIAL BRAND LIGHT THEME                                       -->
    <!-- Clean, High-Contrast Modern Studio Workspace                              -->
    <!-- ========================================================================= -->

    <!-- Core Brand Color Palette (Light Adjusted) -->
    <Color x:Key="Color.Brand.Primary">#553CDE</Color>
    <Color x:Key="Color.Brand.Secondary">#0E8A7B</Color>
    <Color x:Key="Color.Brand.Accent">#1F75D3</Color>

    <!-- Surfaces & Backgrounds -->
    <Color x:Key="Color.WindowBackground">#F5F6FA</Color>
    <Color x:Key="Color.SidebarBackground">#ECEFF5</Color>
    <Color x:Key="Color.TopbarBackground">#FFFFFF</Color>
    <Color x:Key="Color.StatusBarBackground">#E6E9F0</Color>
    <Color x:Key="Color.SurfacePrimary">#FFFFFF</Color>
    <Color x:Key="Color.SurfaceSecondary">#F0F2F7</Color>
    <Color x:Key="Color.SurfaceElevated">#E5E8F0</Color>
    <Color x:Key="Color.ViewportCanvas">#E1E4EB</Color>

    <!-- Borders -->
    <Color x:Key="Color.BorderSubtle">#DDE2EC</Color>
    <Color x:Key="Color.BorderStrong">#CBD1DE</Color>
    <Color x:Key="Color.BorderAccent">#553CDE</Color>

    <!-- Accents & Interactivity -->
    <Color x:Key="Color.AccentPrimary">#553CDE</Color>
    <Color x:Key="Color.AccentHover">#6850F2</Color>
    <Color x:Key="Color.AccentPressed">#432CB8</Color>
    <Color x:Key="Color.AccentMuted">#E6E2FF</Color>

    <Color x:Key="Color.SecondaryPrimary">#0E8A7B</Color>
    <Color x:Key="Color.SecondaryHover">#15A695</Color>
    <Color x:Key="Color.SecondaryMuted">#D6F5F0</Color>

    <!-- Typography Text Colors -->
    <Color x:Key="Color.TextPrimary">#161922</Color>
    <Color x:Key="Color.TextSecondary">#4B5565</Color>
    <Color x:Key="Color.TextMuted">#8893A7</Color>
    <Color x:Key="Color.TextDisabled">#B0B8C7</Color>

    <!-- Status Indicators -->
    <Color x:Key="Color.StatusSuccess">#16A34A</Color>
    <Color x:Key="Color.StatusWarning">#D97706</Color>
    <Color x:Key="Color.StatusDanger">#DC2626</Color>
    <Color x:Key="Color.StatusInfo">#0284C7</Color>

    <!-- SolidColorBrushes -->
    <SolidColorBrush x:Key="Brush.WindowBackground" Color="{StaticResource Color.WindowBackground}" />
    <SolidColorBrush x:Key="Brush.SidebarBackground" Color="{StaticResource Color.SidebarBackground}" />
    <SolidColorBrush x:Key="Brush.TopbarBackground" Color="{StaticResource Color.TopbarBackground}" />
    <SolidColorBrush x:Key="Brush.StatusBarBackground" Color="{StaticResource Color.StatusBarBackground}" />
    <SolidColorBrush x:Key="Brush.SurfacePrimary" Color="{StaticResource Color.SurfacePrimary}" />
    <SolidColorBrush x:Key="Brush.SurfaceSecondary" Color="{StaticResource Color.SurfaceSecondary}" />
    <SolidColorBrush x:Key="Brush.SurfaceElevated" Color="{StaticResource Color.SurfaceElevated}" />
    <SolidColorBrush x:Key="Brush.ViewportCanvas" Color="{StaticResource Color.ViewportCanvas}" />

    <SolidColorBrush x:Key="Brush.BorderSubtle" Color="{StaticResource Color.BorderSubtle}" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="{StaticResource Color.BorderStrong}" />
    <SolidColorBrush x:Key="Brush.BorderAccent" Color="{StaticResource Color.BorderAccent}" />

    <SolidColorBrush x:Key="Brush.AccentPrimary" Color="{StaticResource Color.AccentPrimary}" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="{StaticResource Color.AccentHover}" />
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="{StaticResource Color.AccentPressed}" />
    <SolidColorBrush x:Key="Brush.AccentMuted" Color="{StaticResource Color.AccentMuted}" />

    <SolidColorBrush x:Key="Brush.SecondaryPrimary" Color="{StaticResource Color.SecondaryPrimary}" />
    <SolidColorBrush x:Key="Brush.SecondaryHover" Color="{StaticResource Color.SecondaryHover}" />
    <SolidColorBrush x:Key="Brush.SecondaryMuted" Color="{StaticResource Color.SecondaryMuted}" />

    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}" />
    <SolidColorBrush x:Key="Brush.TextDisabled" Color="{StaticResource Color.TextDisabled}" />

    <SolidColorBrush x:Key="Brush.StatusSuccess" Color="{StaticResource Color.StatusSuccess}" />
    <SolidColorBrush x:Key="Brush.StatusWarning" Color="{StaticResource Color.StatusWarning}" />
    <SolidColorBrush x:Key="Brush.StatusDanger" Color="{StaticResource Color.StatusDanger}" />
    <SolidColorBrush x:Key="Brush.StatusInfo" Color="{StaticResource Color.StatusInfo}" />

</ResourceDictionary>

