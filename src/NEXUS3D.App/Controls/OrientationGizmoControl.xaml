<UserControl x:Class="NEXUS3D.App.Controls.OrientationGizmoControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="120" d:DesignWidth="120">
    <Border Background="#CC141419"
            BorderBrush="#44FFFFFF"
            BorderThickness="1"
            CornerRadius="8"
            Padding="6"
            Width="110"
            Height="110">
        <Grid>
            <!-- Center ISO / Reset Button -->
            <Button x:Name="BtnIso"
                    Click="OnPresetClick"
                    Tag="Isometric"
                    Width="30"
                    Height="30"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#282836"
                    Foreground="#A29BFE"
                    BorderThickness="1"
                    BorderBrush="#6C5CE7"
                    FontWeight="Bold"
                    FontSize="10"
                    Content="ISO"
                    ToolTip="Isometric View (3D Orbit)"
                    Cursor="Hand" />

            <!-- +Y Top (Green) -->
            <Button Click="OnPresetClick"
                    Tag="Top"
                    Width="24"
                    Height="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,2,0,0"
                    Background="#1E382B"
                    Foreground="#55EFC4"
                    BorderThickness="1"
                    BorderBrush="#55EFC4"
                    FontWeight="Bold"
                    FontSize="9"
                    Content="+Y"
                    ToolTip="Top View (5)"
                    Cursor="Hand" />

            <!-- -Y Bottom -->
            <Button Click="OnPresetClick"
                    Tag="Bottom"
                    Width="24"
                    Height="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,2"
                    Background="#1E2822"
                    Foreground="#2ED573"
                    BorderThickness="1"
                    BorderBrush="#2ED573"
                    FontSize="9"
                    Content="-Y"
                    ToolTip="Bottom View"
                    Cursor="Hand" />

            <!-- -X Left -->
            <Button Click="OnPresetClick"
                    Tag="Left"
                    Width="20"
                    Height="24"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Margin="2,0,0,0"
                    Background="#381E1E"
                    Foreground="#FF7675"
                    BorderThickness="1"
                    BorderBrush="#FF7675"
                    FontSize="9"
                    Content="-X"
                    ToolTip="Left View"
                    Cursor="Hand" />

            <!-- +X Right (Red) -->
            <Button Click="OnPresetClick"
                    Tag="Right"
                    Width="20"
                    Height="24"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,2,0"
                    Background="#3D1A1A"
                    Foreground="#FF4757"
                    BorderThickness="1"
                    BorderBrush="#FF4757"
                    FontWeight="Bold"
                    FontSize="9"
                    Content="+X"
                    ToolTip="Right View (4)"
                    Cursor="Hand" />

            <!-- +Z Front (Blue) Bottom-Right diagonal -->
            <Button Click="OnPresetClick"
                    Tag="Front"
                    Width="24"
                    Height="18"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Margin="4,0,0,4"
                    Background="#182A3A"
                    Foreground="#74B9FF"
                    BorderThickness="1"
                    BorderBrush="#74B9FF"
                    FontWeight="Bold"
                    FontSize="8"
                    Content="FRONT"
                    ToolTip="Front View (1)"
                    Cursor="Hand" />

            <!-- -Z Back (Dark Blue) Top-Right diagonal -->
            <Button Click="OnPresetClick"
                    Tag="Back"
                    Width="24"
                    Height="18"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,4,4,0"
                    Background="#141E28"
                    Foreground="#0984E3"
                    BorderThickness="1"
                    BorderBrush="#0984E3"
                    FontSize="8"
                    Content="BACK"
                    ToolTip="Back View"
                    Cursor="Hand" />
        </Grid>
    </Border>
</UserControl>
