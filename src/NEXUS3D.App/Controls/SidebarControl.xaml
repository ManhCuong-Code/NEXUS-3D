<UserControl x:Class="NEXUS3D.App.Controls.SidebarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Width="230">
    <Border Background="{StaticResource Brush.SidebarBackground}"
            BorderBrush="{StaticResource Brush.BorderSubtle}"
            BorderThickness="0,0,1,0">
        <DockPanel LastChildFill="True">
            <!-- Bottom Architecture Info Card -->
            <Border DockPanel.Dock="Bottom"
                    Background="{StaticResource Brush.SurfacePrimary}"
                    BorderBrush="{StaticResource Brush.BorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Margin="12"
                    Padding="12,10">
                <StackPanel>
                    <TextBlock Text="FOUNDATION STAGE 01"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{StaticResource Brush.AccentHover}" />
                    <TextBlock Text="SQLite &amp; File Logging Active"
                               FontSize="11.5"
                               Foreground="{StaticResource Brush.TextSecondary}"
                               Margin="0,3,0,0" />
                </StackPanel>
            </Border>

            <!-- Navigation Menu Items -->
            <StackPanel Margin="0,14,0,0">
                <TextBlock Text="CORE MODULES"
                           FontSize="10.5"
                           FontWeight="Bold"
                           Foreground="{StaticResource Brush.TextMuted}"
                           Margin="20,0,0,6" />

                <RadioButton Style="{StaticResource Style.SidebarNavButton}"
                             GroupName="MainNav"
                             Tag="{StaticResource Icon.Dashboard}"
                             Content="Dashboard"
                             IsChecked="{Binding IsDashboardActive, Mode=OneWay}"
                             Command="{Binding NavigateDashboardCommand}" />

                <RadioButton Style="{StaticResource Style.SidebarNavButton}"
                             GroupName="MainNav"
                             Tag="{StaticResource Icon.Converter}"
                             Content="3D Converter"
                             IsChecked="{Binding IsConverterActive, Mode=OneWay}"
                             Command="{Binding NavigateConverterCommand}" />

                <RadioButton Style="{StaticResource Style.SidebarNavButton}"
                             GroupName="MainNav"
                             Tag="{StaticResource Icon.Converter}"
                             Content="3D Viewport"
                             IsChecked="{Binding IsViewportActive, Mode=OneWay}"
                             Command="{Binding NavigateViewportCommand}" />

                <RadioButton Style="{StaticResource Style.SidebarNavButton}"
                             GroupName="MainNav"
                             Tag="{StaticResource Icon.FileManager}"
                             Content="File Manager"
                             IsChecked="{Binding IsFileManagerActive, Mode=OneWay}"
                             Command="{Binding NavigateFileManagerCommand}" />

                <RadioButton Style="{StaticResource Style.SidebarNavButton}"
                             GroupName="MainNav"
                             Tag="{StaticResource Icon.Settings}"
                             Content="Settings"
                             IsChecked="{Binding IsSettingsActive, Mode=OneWay}"
                             Command="{Binding NavigateSettingsCommand}" />

                <Separator Background="{StaticResource Brush.BorderSubtle}" Margin="16,14" />

                <TextBlock Text="UPCOMING STAGES"
                           FontSize="10.5"
                           FontWeight="Bold"
                           Foreground="{StaticResource Brush.TextMuted}"
                           Margin="20,0,0,6" />

                <!-- Disabled Upcoming Modules demonstrating Disabled state -->
                <RadioButton Style="{StaticResource Style.SidebarNavButton}"
                             GroupName="MainNav"
                             Tag="{StaticResource Icon.Viewport}"
                             Content="3D Viewport Editor"
                             IsEnabled="False"
                             ToolTip="Planned for Stage 05 – Interactive 3D Viewport" />

                <RadioButton Style="{StaticResource Style.SidebarNavButton}"
                             GroupName="MainNav"
                             Tag="{StaticResource Icon.Plugin}"
                             Content="Mesh Optimizer"
                             IsEnabled="False"
                             ToolTip="Planned for Stage 07 – Geometry Optimization" />
            </StackPanel>
        </DockPanel>
    </Border>
</UserControl>

