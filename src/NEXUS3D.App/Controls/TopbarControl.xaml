<UserControl x:Class="NEXUS3D.App.Controls.TopbarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Height="54">
    <Border Background="{StaticResource Brush.TopbarBackground}"
            BorderBrush="{StaticResource Brush.BorderSubtle}"
            BorderThickness="0,0,0,1"
            Padding="18,0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Brand Identity -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{StaticResource Brush.AccentMuted}"
                        BorderBrush="{StaticResource Brush.AccentPrimary}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Width="32" Height="32"
                        Margin="0,0,12,0">
                    <Path Data="{StaticResource Icon.Cube3D}"
                          Fill="{StaticResource Brush.AccentHover}"
                          Stretch="Uniform"
                          Width="18" Height="18"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding ApplicationTitle}"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource Brush.TextPrimary}" />
                        <Border Background="{StaticResource Brush.SurfaceSecondary}"
                                BorderBrush="{StaticResource Brush.BorderStrong}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="6,1"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding VersionBadge}"
                                       FontSize="10.5"
                                       Foreground="{StaticResource Brush.AccentHover}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding ApplicationSubtitle}"
                               FontSize="11"
                               Foreground="{StaticResource Brush.TextSecondary}" />
                </StackPanel>
            </StackPanel>

            <!-- Active Module Breadcrumb -->
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Border Background="{StaticResource Brush.SurfacePrimary}"
                        BorderBrush="{StaticResource Brush.BorderSubtle}"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="12,5">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8"
                                 Fill="{StaticResource Brush.StatusSuccess}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,8,0" />
                        <TextBlock Text="Active Workspace:"
                                   FontSize="11.5"
                                   Foreground="{StaticResource Brush.TextSecondary}"
                                   Margin="0,0,6,0" />
                        <TextBlock Text="{Binding ActiveModule}"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.TextPrimary}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Right Actions: Workstation Status & Notification Toggle -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{StaticResource Brush.SurfacePrimary}"
                        BorderBrush="{StaticResource Brush.BorderSubtle}"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="10,5"
                        Margin="0,0,10,0">
                    <TextBlock Text=".NET 10 LTS • Clean Architecture"
                               FontSize="11"
                               Foreground="{StaticResource Brush.TextSecondary}" />
                </Border>

                <Button Style="{StaticResource Style.SecondaryButton}"
                        Command="{Binding ToggleNotificationPanelCommand}"
                        ToolTip="Toggle Notification &amp; Alert Center">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.Bell}"
                              Fill="{StaticResource Brush.TextPrimary}"
                              Width="14" Height="14"
                              Stretch="Uniform"
                              VerticalAlignment="Center"
                              Margin="0,0,6,0" />
                        <TextBlock Text="Alerts" VerticalAlignment="Center" />
                        <Border Background="{StaticResource Brush.AccentPrimary}"
                                CornerRadius="8"
                                Padding="5,1"
                                Margin="6,0,0,0"
                                Visibility="{Binding HasUnreadNotifications, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding UnreadNotificationCount}"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource Brush.TextPrimary}" />
                        </Border>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>

