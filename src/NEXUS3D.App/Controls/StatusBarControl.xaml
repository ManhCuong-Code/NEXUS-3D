<UserControl x:Class="NEXUS3D.App.Controls.StatusBarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Height="28">
    <Border Background="{StaticResource Brush.StatusBarBackground}"
            BorderBrush="{StaticResource Brush.BorderSubtle}"
            BorderThickness="0,1,0,0"
            Padding="14,0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="7" Height="7"
                         Fill="{StaticResource Brush.StatusInfo}"
                         VerticalAlignment="Center"
                         Margin="0,0,7,0" />
                <TextBlock Text="{Binding CurrentViewModel.StatusMessage, FallbackValue='Ready'}"
                           FontSize="11"
                           Foreground="{StaticResource Brush.TextSecondary}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Grid.Column="1"
                       Text="{Binding LatestNotificationText}"
                       FontSize="11"
                       Foreground="{StaticResource Brush.TextMuted}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Margin="20,0" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                <TextBlock Text="Storage:"
                           FontSize="11"
                           Foreground="{StaticResource Brush.TextMuted}"
                           Margin="0,0,4,0" />
                <TextBlock Text="{Binding DatabaseStatusText}"
                           FontSize="11"
                           Foreground="{StaticResource Brush.StatusSuccess}" />
            </StackPanel>

            <TextBlock Grid.Column="3"
                       Text="UTF-8 • Y-Up Coordinate System"
                       FontSize="11"
                       Foreground="{StaticResource Brush.TextMuted}"
                       VerticalAlignment="Center" />
        </Grid>
    </Border>
</UserControl>

