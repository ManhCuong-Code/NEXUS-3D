<Window x:Class="NEXUS3D.App.Views.ConvertModelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:NEXUS3D.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ConvertModelDialogViewModel}"
        Title="NEXUS-3D - Smart Conversion Assistant"
        Width="700" Height="620"
        MinWidth="600" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="#141419"
        Foreground="#F0F0F0"
        WindowStyle="ThreeDBorderWindow">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto" />
            <!-- Source Summary Card -->
            <RowDefinition Height="Auto" />
            <!-- Target Selection & Loss Analysis -->
            <RowDefinition Height="*" />
            <!-- Destination Path -->
            <RowDefinition Height="Auto" />
            <!-- Progress & Status -->
            <RowDefinition Height="Auto" />
            <!-- Actions -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Header -->
        <Border Grid.Row="0" Margin="0,0,0,12">
            <DockPanel>
                <Border Width="38" Height="38" Background="#00CEC9" CornerRadius="8" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="⚡" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#141419" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="SMART CONVERSION ASSISTANT" FontSize="16" FontWeight="Black" Foreground="#FFFFFF" />
                    <TextBlock Text="Cross-format pipeline with intelligent feature preservation and live loss diagnostics." FontSize="11" Foreground="#A0A0B0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 2. Source Summary Card -->
        <Border Grid.Row="1" Background="#1C1C26" BorderBrush="#2D2D3D" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding SourceModelName}" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding SourceFilePath}" FontSize="11" Foreground="#888898" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="#28283C" BorderBrush="#00CEC9" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding SourceFormatName}" FontSize="11" FontWeight="Bold" Foreground="#00CEC9" />
                    </Border>
                    <TextBlock Text="{Binding GeometrySummary}" FontSize="10" Foreground="#55EFC4" HorizontalAlignment="Right" Margin="0,3,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. Target Selection & Loss Analysis -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Target Format Options List -->
            <Border Grid.Column="0" Background="#181822" BorderBrush="#2A2A38" BorderThickness="1" CornerRadius="6" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="SELECT TARGET FORMAT" FontSize="11" FontWeight="Bold" Foreground="#A29BFE" Margin="0,0,0,6" />
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding TargetOptions}"
                             SelectedItem="{Binding SelectedTarget}"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="#E0E0E0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#20202E" BorderBrush="#2F2F44" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,3">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF" />
                                            <TextBlock Text="{Binding PrimaryExtension}" FontSize="10" Foreground="#888898" HorizontalAlignment="Right" />
                                        </DockPanel>
                                        <Border Background="{Binding RatingColor}" CornerRadius="2" Padding="4,1" Margin="0,4,0,0" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding RatingBadge}" FontSize="9" FontWeight="Bold" Foreground="#141419" />
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Target Loss & Fidelity Diagnostic -->
            <Border Grid.Column="2" Background="#181822" BorderBrush="#2A2A38" BorderThickness="1" CornerRadius="6" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="FIDELITY &amp; LOSS DIAGNOSTICS" FontSize="11" FontWeight="Bold" Foreground="#00CEC9" Margin="0,0,0,6" />

                        <TextBlock Text="{Binding SelectedTarget.RatingDescription}" FontSize="12" Foreground="#E0E0E0" TextWrapping="Wrap" Margin="0,0,0,10" />

                        <!-- Preserved Features -->
                        <TextBlock Text="Preserved Capabilities:" FontSize="11" FontWeight="Bold" Foreground="#55EFC4" Margin="0,4,0,4" />
                        <ItemsControl ItemsSource="{Binding SelectedTarget.PreservedFeatures}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,1">
                                        <TextBlock Text="✓ " Foreground="#55EFC4" FontWeight="Bold" FontSize="11" />
                                        <TextBlock Text="{Binding}" FontSize="11" Foreground="#D0D0D0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Approximated or Lost Features -->
                        <TextBlock Text="Potential Structural Changes / Loss:" FontSize="11" FontWeight="Bold" Foreground="#FF7675" Margin="0,10,0,4" />
                        <ItemsControl ItemsSource="{Binding SelectedTarget.ApproximateOrLostFeatures}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,1">
                                        <TextBlock Text="⚠ " Foreground="#FDCB6E" FontWeight="Bold" FontSize="11" />
                                        <TextBlock Text="{Binding}" FontSize="11" Foreground="#C0C0C0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 4. Destination File Path -->
        <Border Grid.Row="3" Background="#181822" BorderBrush="#2A2A38" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Output:" FontSize="11" Foreground="#A0A0B0" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Grid.Column="1" Text="{Binding DestinationFilePath, UpdateSourceTrigger=PropertyChanged}" Background="#20202E" Foreground="#FFFFFF" BorderBrush="#3D3D52" Padding="6,4" FontSize="11" FontFamily="Consolas" />
                <Button Grid.Column="2" Content="Browse..." Command="{Binding BrowseDestinationCommand}" Background="#2E2E40" Foreground="#FFFFFF" BorderThickness="0" Padding="12,4" Margin="6,0,0,0" Cursor="Hand" />
            </Grid>
        </Border>

        <!-- 5. Progress & Status -->
        <StackPanel Grid.Row="4" Margin="0,0,0,10">
            <ProgressBar Value="{Binding ConversionProgress}" Maximum="100" Height="4" Background="#20202E" Foreground="#00CEC9" BorderThickness="0" Margin="0,0,0,4" />
            <DockPanel>
                <TextBlock Text="{Binding ConversionStatus}" FontSize="11" Foreground="#55EFC4" />
                <TextBlock Text="{Binding ErrorMessage}" FontSize="11" Foreground="#FF7675" HorizontalAlignment="Right" />
            </DockPanel>
        </StackPanel>

        <!-- 6. Actions Footer -->
        <DockPanel Grid.Row="5">
            <StackPanel Orientation="Horizontal">
                <Button Content="Open in New Workspace"
                        Command="{Binding OpenInNewWorkspaceCommand}"
                        Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"
                        Padding="14,8"
                        Background="#252533"
                        Foreground="#55EFC4"
                        BorderBrush="#55EFC4"
                        BorderThickness="1"
                        Cursor="Hand" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Close"
                        Command="{Binding CloseCommand}"
                        Padding="16,8"
                        Background="#252533"
                        Foreground="#CCCCCC"
                        BorderBrush="#3D3D52"
                        BorderThickness="1"
                        Cursor="Hand"
                        Margin="0,0,10,0" />

                <Button Content="Convert Now ⚡"
                        Command="{Binding ConvertNowCommand}"
                        IsEnabled="{Binding CanConvert}"
                        Padding="22,8"
                        Background="#00CEC9"
                        Foreground="#141419"
                        BorderThickness="0"
                        FontWeight="Bold"
                        Cursor="Hand" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
