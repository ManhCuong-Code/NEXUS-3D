<UserControl x:Class="NEXUS3D.App.Views.FileManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="22">
            <!-- Header & Toolbar -->
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.PageTitle}" />
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.PageSubtitle}" Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox Width="220"
                             Style="{StaticResource Style.InputTextBox}"
                             Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Filter by file name, path, or format"
                             Margin="0,0,8,0" />
                    <Button Style="{StaticResource Style.SecondaryButton}"
                            Content="Refresh"
                            Margin="0,0,8,0"
                            Command="{Binding LoadAllRecordsCommand}" />
                    <Button Style="{StaticResource Style.SecondaryButton}"
                            Content="Clear History"
                            Margin="0,0,8,0"
                            Command="{Binding ClearHistoryCommand}" />
                    <Button Style="{StaticResource Style.PrimaryButton}"
                            Content="+ Register Model File"
                            Command="{Binding AddModelFileToWorkspaceCommand}" />
                </StackPanel>
            </Grid>

            <!-- Split Layout: Recent Files & Conversion History -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Column: Recent 3D Files -->
                <Border Grid.Column="0" Style="{StaticResource Style.CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Recent 3D Model Files" Style="{StaticResource Text.SectionHeader}" />
                        <TextBlock Text="Recently inspected or imported 3D assets stored in SQLite."
                                   Style="{StaticResource Text.MutedCaption}"
                                   Margin="0,2,0,12" />

                        <ItemsControl ItemsSource="{Binding RecentFiles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Brush.SurfaceSecondary}"
                                            BorderBrush="{StaticResource Brush.BorderSubtle}"
                                            BorderThickness="1"
                                            CornerRadius="5"
                                            Padding="12,9"
                                            Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding FileName}"
                                                               FontWeight="SemiBold"
                                                               FontSize="12.5"
                                                               Foreground="{StaticResource Brush.TextPrimary}" />
                                                    <Border Background="{StaticResource Brush.AccentMuted}"
                                                            CornerRadius="3"
                                                            Padding="5,1"
                                                            Margin="8,0,0,0">
                                                        <TextBlock Text="{Binding Format}"
                                                                   FontSize="10"
                                                                   Foreground="{StaticResource Brush.AccentHover}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding FilePath}"
                                                           Style="{StaticResource Text.Monospace}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,3,0,0" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                                <Button Style="{StaticResource Style.SecondaryButton}"
                                                        Content="Pin"
                                                        Padding="8,3"
                                                        Margin="0,0,6,0"
                                                        Command="{Binding DataContext.TogglePinCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Style="{StaticResource Style.SecondaryButton}"
                                                        Content="Remove"
                                                        Padding="8,3"
                                                        Command="{Binding DataContext.RemoveRecentFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Right Column: Conversion Audit History -->
                <Border Grid.Column="2" Style="{StaticResource Style.CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Conversion Job History" Style="{StaticResource Text.SectionHeader}" />
                        <TextBlock Text="Prepared and completed conversion jobs tracked in SQLite."
                                   Style="{StaticResource Text.MutedCaption}"
                                   Margin="0,2,0,12" />

                        <ItemsControl ItemsSource="{Binding ConversionHistory}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Brush.SurfaceSecondary}"
                                            BorderBrush="{StaticResource Brush.BorderSubtle}"
                                            BorderThickness="1"
                                            CornerRadius="5"
                                            Padding="12,9"
                                            Margin="0,0,0,8">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding JobName}"
                                                           FontWeight="SemiBold"
                                                           FontSize="12.5"
                                                           Foreground="{StaticResource Brush.TextPrimary}" />
                                                <Border Grid.Column="1"
                                                        Background="{StaticResource Brush.SurfacePrimary}"
                                                        CornerRadius="3"
                                                        Padding="6,2">
                                                    <TextBlock Text="{Binding Status}"
                                                               FontSize="10.5"
                                                               Foreground="{StaticResource Brush.StatusInfo}" />
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{Binding SourceFilePath, StringFormat='Source: {0}'}"
                                                       Style="{StaticResource Text.MutedCaption}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,3,0,0" />
                                            <TextBlock Text="{Binding TargetFilePath, StringFormat='Target: {0}'}"
                                                       Style="{StaticResource Text.MutedCaption}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>

