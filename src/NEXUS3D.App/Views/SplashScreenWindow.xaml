<Window x:Class="NEXUS3D.App.Views.SplashScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="NEXUS-3D Starting..."
        Width="520"
        Height="310"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False">

    <Border Background="{StaticResource Brush.WindowBackground}"
            BorderBrush="{StaticResource Brush.BorderStrong}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="30"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="4" Opacity="0.6" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Brand Logo & Titles -->
            <StackPanel Grid.Row="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <!-- 3D Vector Cube Symbol -->
                <Image Source="{StaticResource Brand.Logo.Symbol}"
                       Width="84" Height="84"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,12" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="NEXUS"
                               FontSize="28"
                               FontWeight="Black"
                               Foreground="{StaticResource Brush.TextPrimary}" />
                    <TextBlock Text="-3D"
                               FontSize="28"
                               FontWeight="Black"
                               Foreground="{StaticResource Brush.SecondaryHover}" />
                </StackPanel>

                <TextBlock Text="UNIVERSAL 3D &amp; SCHEMATIC CONVERTER"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="{StaticResource Brush.TextSecondary}"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0" />
            </StackPanel>

            <!-- Progress Bar -->
            <ProgressBar x:Name="StartupProgressBar"
                         Grid.Row="1"
                         Height="4"
                         IsIndeterminate="True"
                         Foreground="{StaticResource Brush.AccentPrimary}"
                         Background="{StaticResource Brush.SurfaceSecondary}"
                         BorderThickness="0"
                         Margin="0,20,0,8" />

            <!-- Status Text & Runtime Badge -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusTextBlock"
                           Grid.Column="0"
                           Text="Initializing Universal Scene Model..."
                           FontSize="11"
                           Foreground="{StaticResource Brush.TextSecondary}"
                           VerticalAlignment="Center" />

                <TextBlock Grid.Column="1"
                           Text="v1.0.0 • .NET 10 LTS"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource Brush.AccentHover}"
                           VerticalAlignment="Center" />
            </Grid>
        </Grid>
    </Border>
</Window>
