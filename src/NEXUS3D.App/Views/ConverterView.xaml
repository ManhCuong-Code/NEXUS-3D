<UserControl x:Class="NEXUS3D.App.Views.ConverterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:NEXUS3D.App.Controls"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="22">
            <!-- Header -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.PageTitle}" />
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.PageSubtitle}" Margin="0,4,0,0" />
                </StackPanel>

                <Border Grid.Column="1"
                        Background="{StaticResource Brush.SurfacePrimary}"
                        BorderBrush="{StaticResource Brush.BorderStrong}"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="12,6"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding EngineStatusSummary}"
                               FontSize="11.5"
                               Foreground="{StaticResource Brush.AccentHover}" />
                </Border>
            </Grid>

            <!-- Validation Error Banner -->
            <Border Background="#2D161B"
                    BorderBrush="{StaticResource Brush.StatusDanger}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="12,8"
                    Margin="0,0,0,14"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource Brush.TextPrimary}"
                           FontSize="12" />
            </Border>

            <!-- Main Split Workspace: Left Configuration Panel & Right 3D Viewport Stage -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="420" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Panel: Source, Preset Profile, and Parameters -->
                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource Style.CardBorder}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="1. Source Model &amp; Output Path" Style="{StaticResource Text.SectionHeader}" />
                            <TextBlock Text="Select a 3D file (.schem, .obj, .json, .geo.json) to inspect and queue."
                                       Style="{StaticResource Text.MutedCaption}"
                                       Margin="0,2,0,12" />

                            <TextBlock Text="Source Model File Path:" Style="{StaticResource Text.MutedCaption}" Margin="0,0,0,4" />
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Style="{StaticResource Style.InputTextBox}"
                                         Text="{Binding SourceFilePath, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1"
                                        Style="{StaticResource Style.SecondaryButton}"
                                        Content="Browse..."
                                        Margin="8,0,0,0"
                                        Command="{Binding BrowseSourceFileCommand}" />
                            </Grid>

                            <TextBlock Text="Output Directory:" Style="{StaticResource Text.MutedCaption}" Margin="0,0,0,4" />
                            <TextBox Style="{StaticResource Style.InputTextBox}"
                                     Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,10" />

                            <Button Style="{StaticResource Style.SecondaryButton}"
                                    Content="Inspect File Header &amp; Metadata"
                                    HorizontalAlignment="Left"
                                    Command="{Binding InspectSelectedFileCommand}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Style.CardBorder}">
                        <StackPanel>
                            <TextBlock Text="2. Conversion Pipeline Parameters" Style="{StaticResource Text.SectionHeader}" />
                            <TextBlock Text="Choose a built-in profile or customize format conversion rules."
                                       Style="{StaticResource Text.MutedCaption}"
                                       Margin="0,2,0,12" />

                            <TextBlock Text="Conversion Profile Preset:" Style="{StaticResource Text.MutedCaption}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding Profiles}"
                                      SelectedItem="{Binding SelectedProfile}"
                                      DisplayMemberPath="Name"
                                      Padding="8,6"
                                      Margin="0,0,0,10" />

                            <UniformGrid Columns="2" Margin="0,0,0,10">
                                <StackPanel Margin="0,0,6,0">
                                    <TextBlock Text="Source Format:" Style="{StaticResource Text.MutedCaption}" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding AvailableFormats}"
                                              SelectedItem="{Binding SelectedSourceFormat}"
                                              Padding="8,6" />
                                </StackPanel>

                                <StackPanel Margin="6,0,0,0">
                                    <TextBlock Text="Target Format:" Style="{StaticResource Text.MutedCaption}" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding AvailableFormats}"
                                              SelectedItem="{Binding SelectedTargetFormat}"
                                              Padding="8,6" />
                                </StackPanel>
                            </UniformGrid>

                            <TextBlock Text="Uniform Scale Factor (0.0001 - 10000):" Style="{StaticResource Text.MutedCaption}" Margin="0,0,0,4" />
                            <TextBox Style="{StaticResource Style.InputTextBox}"
                                     Text="{Binding ScaleFactor, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,10" />

                            <CheckBox Style="{StaticResource Style.ModernCheckBox}"
                                      Content="Optimize Polygon Mesh Topology"
                                      IsChecked="{Binding OptimizeMesh}" />
                            <CheckBox Style="{StaticResource Style.ModernCheckBox}"
                                      Content="Enable Greedy Meshing for Voxel Surfaces"
                                      IsChecked="{Binding GreedyMeshing}" />
                            <CheckBox Style="{StaticResource Style.ModernCheckBox}"
                                      Content="Preserve Material &amp; UV Texture Definitions"
                                      IsChecked="{Binding PreserveMaterials}"
                                      Margin="0,4,0,14" />

                            <Button Style="{StaticResource Style.PrimaryButton}"
                                    Content="Prepare &amp; Queue Conversion Job"
                                    Command="{Binding PrepareConversionCommand}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right Panel: 3D Viewport Stage Placeholder & Model Inspector -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="340" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Viewport Canvas Card -->
                    <Border Grid.Row="0"
                            Background="{StaticResource Brush.ViewportCanvas}"
                            BorderBrush="{StaticResource Brush.BorderStrong}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <Grid>
                            <!-- Viewport Top Overlay Bar -->
                            <Border VerticalAlignment="Top"
                                    Background="#B0111722"
                                    BorderBrush="{StaticResource Brush.BorderSubtle}"
                                    BorderThickness="0,0,0,1"
                                    Padding="12,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="3D VIEWPORT PREVIEW STAGE"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource Brush.TextSecondary}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text=" • Isometric Camera (Y-Up)"
                                                   FontSize="11"
                                                   Foreground="{StaticResource Brush.TextMuted}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Style="{StaticResource Style.PrimaryButton}"
                                                Content="3D Preview"
                                                Padding="10,4"
                                                Margin="0,0,8,0"
                                                Command="{Binding GeneratePreviewCommand}" />
                                        <Button Style="{StaticResource Style.SecondaryButton}"
                                                Content="Reset Camera"
                                                Padding="8,4"
                                                Command="{Binding ResetViewportCameraCommand}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Live 3D Viewport Control -->
                            <controls:Viewport3DControl Margin="0,40,0,0"
                                                        MinHeight="320"
                                                        Scene="{Binding PreviewScene}" />
                        </Grid>
                    </Border>

                    <!-- Bottom Inspector Summary Card -->
                    <Border Grid.Row="2" Style="{StaticResource Style.CardBorder}">
                        <UniformGrid Columns="3">
                            <StackPanel>
                                <TextBlock Text="INSPECTED MODEL NAME" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Brush.TextMuted}" />
                                <TextBlock Text="{Binding InspectedModelName}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextPrimary}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="NATIVE GEOMETRY KIND" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Brush.TextMuted}" />
                                <TextBlock Text="{Binding InspectedGeometryKind}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource Brush.AccentHover}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="FILE SIZE ON DISK" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Brush.TextMuted}" />
                                <TextBlock Text="{Binding InspectedFileSize}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource Brush.StatusSuccess}" Margin="0,4,0,0" />
                            </StackPanel>
                        </UniformGrid>
                    </Border>
                </Grid>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>

