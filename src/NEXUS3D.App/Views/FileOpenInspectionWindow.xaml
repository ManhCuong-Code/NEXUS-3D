<Window x:Class="NEXUS3D.App.Views.FileOpenInspectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:NEXUS3D.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:FileOpenInspectionViewModel}"
        Title="NEXUS-3D - Pre-Open Model Inspection"
        Width="640" Height="520"
        MinWidth="560" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="#141419"
        Foreground="#F0F0F0"
        WindowStyle="ThreeDBorderWindow">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto" />
            <!-- File Info Card -->
            <RowDefinition Height="Auto" />
            <!-- Readable Components & Warnings -->
            <RowDefinition Height="*" />
            <!-- Manual Override & Toggles -->
            <RowDefinition Height="Auto" />
            <!-- Actions -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Header -->
        <Border Grid.Row="0" Margin="0,0,0,14">
            <DockPanel>
                <Border Width="38" Height="38" Background="#6C5CE7" CornerRadius="8" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="🔍" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="PRE-OPEN MODEL INSPECTION" FontSize="16" FontWeight="Black" Foreground="#FFFFFF" />
                    <TextBlock Text="Deep file analysis, structural validation, and workspace routing." FontSize="11" Foreground="#A0A0B0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 2. File & Format Card -->
        <Border Grid.Row="1" Background="#1C1C26" BorderBrush="#2D2D3D" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding Report.FileName}" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Report.FilePath}" FontSize="11" Foreground="#888898" TextTrimming="CharacterEllipsis" Margin="0,2,0,4" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Size: " FontSize="11" Foreground="#888898" />
                        <TextBlock Text="{Binding Report.FormattedFileSize}" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,12,0" />
                        <TextBlock Text="Parser: " FontSize="11" Foreground="#888898" />
                        <TextBlock Text="{Binding Report.ParserName}" FontSize="11" Foreground="#A29BFE" />
                    </StackPanel>
                </StackPanel>

                <!-- Confidence & Format Badge -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="#28283C" BorderBrush="#6C5CE7" BorderThickness="1" CornerRadius="4" Padding="8,4" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding Report.FormatDisplayName}" FontSize="12" FontWeight="Bold" Foreground="#55EFC4" />
                    </Border>
                    <TextBlock Text="{Binding Report.Confidence, StringFormat='Confidence: {0}'}" FontSize="10" Foreground="#A0A0B0" HorizontalAlignment="Right" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. Details: Readable Components & Warnings -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Readable Components -->
            <Border Grid.Column="0" Background="#181822" BorderBrush="#2A2A38" BorderThickness="1" CornerRadius="6" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="DETECTED COMPONENTS" FontSize="11" FontWeight="Bold" Foreground="#55EFC4" Margin="0,0,0,6" />
                    <ListBox Grid.Row="1" ItemsSource="{Binding Report.ReadableComponents}" Background="Transparent" BorderThickness="0" Foreground="#E0E0E0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Text="✓ " Foreground="#55EFC4" FontWeight="Bold" FontSize="12" />
                                    <TextBlock Text="{Binding}" FontSize="11" Foreground="#F0F0F0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Potential Warnings -->
            <Border Grid.Column="2" Background="#181822" BorderBrush="#2A2A38" BorderThickness="1" CornerRadius="6" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="PRE-FLIGHT NOTICES" FontSize="11" FontWeight="Bold" Foreground="#FDCB6E" Margin="0,0,0,6" />
                    <ListBox Grid.Row="1" ItemsSource="{Binding Report.PotentialWarnings}" Background="Transparent" BorderThickness="0" Foreground="#E0E0E0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Text="⚠ " Foreground="#FDCB6E" FontWeight="Bold" FontSize="11" />
                                    <TextBlock Text="{Binding}" FontSize="11" Foreground="#D0D0D0" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- 4. Manual Format / Workspace Override -->
        <Border Grid.Row="3" Background="#181822" BorderBrush="#2A2A38" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,14">
            <DockPanel>
                <TextBlock Text="Specialized Workspace:" FontSize="11" Foreground="#A0A0B0" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox ItemsSource="{Binding AvailableCategories}"
                          SelectedItem="{Binding SelectedCategory}"
                          Width="190"
                          Background="#252533"
                          Foreground="#FFFFFF"
                          BorderBrush="#3D3D52"
                          Padding="6,4"
                          FontSize="11" />
                <TextBlock Text="Routes model into optimal editor layout." FontSize="10" Foreground="#707085" VerticalAlignment="Center" Margin="10,0,0,0" />
            </DockPanel>
        </Border>

        <!-- 5. Actions Footer -->
        <DockPanel Grid.Row="4">
            <CheckBox Content="Always inspect before opening"
                      IsChecked="{Binding AlwaysInspectFiles}"
                      Foreground="#888898"
                      FontSize="11"
                      VerticalAlignment="Center" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Command="{Binding CancelCommand}"
                        Padding="16,8"
                        Background="#252533"
                        Foreground="#CCCCCC"
                        BorderBrush="#3D3D52"
                        BorderThickness="1"
                        Cursor="Hand"
                        Margin="0,0,10,0" />

                <Button Content="Open In Workspace"
                        Command="{Binding OpenCommand}"
                        Padding="20,8"
                        Background="#6C5CE7"
                        Foreground="#FFFFFF"
                        BorderThickness="0"
                        FontWeight="Bold"
                        Cursor="Hand" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
