<Window x:Class="NEXUS3D.App.Views.KeyboardShortcutsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:NEXUS3D.App.ViewModels"
        xmlns:sc="clr-namespace:NEXUS3D.App.Services.Shortcuts"
        mc:Ignorable="d"
        Title="Keyboard Shortcuts – NEXUS-3D"
        Width="780"
        Height="580"
        MinWidth="650"
        MinHeight="450"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.WindowBackground}"
        Foreground="{StaticResource Brush.TextPrimary}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto" />
            <!-- Search & Filter Controls -->
            <RowDefinition Height="Auto" />
            <!-- Shortcuts List with Visual Keycaps -->
            <RowDefinition Height="*" />
            <!-- Footer & Reset Actions -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="34" Height="34"
                        Background="{StaticResource Brush.AccentMuted}"
                        BorderBrush="{StaticResource Brush.AccentPrimary}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Margin="0,0,12,0">
                    <Path Data="{StaticResource Icon.Keyboard}"
                          Fill="{StaticResource Brush.AccentHover}"
                          Width="18" Height="18"
                          Stretch="Uniform"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Keyboard Shortcuts" Style="{StaticResource Text.PageTitle}" FontSize="18" />
                    <TextBlock Text="Quick reference guide and customizable keybindings" Style="{StaticResource Text.PageSubtitle}" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Search Bar & Category Filter -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Search Box with Icon -->
            <Border Grid.Column="0"
                    Background="{StaticResource Brush.SurfacePrimary}"
                    BorderBrush="{StaticResource Brush.BorderStrong}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10,0"
                    Margin="0,0,12,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0"
                          Data="{StaticResource Icon.Search}"
                          Fill="{StaticResource Brush.TextSecondary}"
                          Width="14" Height="14"
                          Stretch="Uniform"
                          VerticalAlignment="Center" />
                    <TextBox Grid.Column="1"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{StaticResource Brush.TextPrimary}"
                             CaretBrush="{StaticResource Brush.AccentHover}"
                             FontSize="12.5"
                             Padding="6,8"
                             VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Category Selector -->
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding Categories}"
                      SelectedItem="{Binding SelectedCategoryName}"
                      Width="170"
                      Background="{StaticResource Brush.SurfacePrimary}"
                      Foreground="{StaticResource Brush.TextPrimary}"
                      BorderBrush="{StaticResource Brush.BorderStrong}"
                      FontSize="12"
                      VerticalContentAlignment="Center"
                      Padding="8,6" />
        </Grid>

        <!-- Shortcuts Data List with Visual Keycaps -->
        <Border Grid.Row="2"
                Background="{StaticResource Brush.SurfacePrimary}"
                BorderBrush="{StaticResource Brush.BorderStrong}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="6"
                Margin="0,0,0,14">
            <ListView ItemsSource="{Binding FilteredShortcuts}"
                      SelectedItem="{Binding SelectedShortcut}"
                      Background="Transparent"
                      BorderThickness="0"
                      Foreground="{StaticResource Brush.TextPrimary}"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                        <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderSubtle}" />
                        <Setter Property="Padding" Value="12,9" />
                        <Setter Property="Margin" Value="2" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="5">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource Brush.SurfaceSecondary}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{StaticResource Brush.SurfaceElevated}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate DataType="{x:Type sc:KeyboardShortcutDefinition}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <!-- Category Badge -->
                                <ColumnDefinition Width="130" />
                                <!-- Name & Description -->
                                <ColumnDefinition Width="*" />
                                <!-- Keycap Combination -->
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Category Badge -->
                            <Border Grid.Column="0"
                                    Style="{StaticResource Style.StatusBadge}"
                                    HorizontalAlignment="Left">
                                <TextBlock Text="{Binding Category}"
                                           FontSize="10.5"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.SecondaryHover}" />
                            </Border>

                            <!-- Name & Description -->
                            <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.TextPrimary}" />
                                <TextBlock Text="{Binding Description}"
                                           FontSize="11"
                                           Foreground="{StaticResource Brush.TextSecondary}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <!-- Visual Keycaps Component -->
                            <ItemsControl Grid.Column="2"
                                          ItemsSource="{Binding KeycapTokens}"
                                          VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Style.ShortcutKeycap}">
                                            <TextBlock Text="{Binding}" Style="{StaticResource Text.Keycap}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Status message -->
            <TextBlock Grid.Column="0"
                       Text="{Binding StatusFeedback}"
                       FontSize="11.5"
                       Foreground="{StaticResource Brush.TextSecondary}"
                       VerticalAlignment="Center" />

            <!-- Action buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource Style.SecondaryButton}"
                        Content="Reset All to Defaults"
                        Command="{Binding ResetAllDefaultsCommand}"
                        Margin="0,0,10,0" />
                <Button Style="{StaticResource Style.PrimaryButton}"
                        Content="Close"
                        Click="OnCloseClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>

