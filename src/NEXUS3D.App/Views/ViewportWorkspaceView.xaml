<UserControl x:Class="NEXUS3D.App.Views.ViewportWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:controls="clr-namespace:NEXUS3D.App.Controls"
             xmlns:contracts="clr-namespace:NEXUS3D.Rendering.Contracts;assembly=NEXUS3D.Rendering"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">
    <Grid Background="#141419">
        <Grid.ColumnDefinitions>
            <!-- Left Sidepane: Hierarchy, Bones, Inspector -->
            <ColumnDefinition Width="280" MinWidth="220" MaxWidth="400" />
            <ColumnDefinition Width="4" />
            <!-- Center/Right: 3D Viewport + Floating Toolbar -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- LEFT PANEL -->
        <Border Grid.Column="0" Background="#1A1A22" BorderBrush="#2A2A36" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="4" />
                    <RowDefinition Height="260" MinHeight="180" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Background="#141419" Padding="12,10" BorderBrush="#2A2A36" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <TextBlock Text="SCENE EXPLORER" FontSize="13" FontWeight="Bold" Foreground="#6C5CE7" />
                        <TextBlock Text="{Binding LoadedModelName}" FontSize="12" Foreground="#E0E0E0" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <!-- Hierarchy & Bones Tabs -->
                <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
                    <TabItem Header="Hierarchy" Foreground="#E0E0E0">
                        <TreeView ItemsSource="{Binding Hierarchy.RootNodes}"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Foreground="#E0E0E0"
                                  Padding="4">
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal" Margin="2">
                                        <TextBlock Text="📦 " FontSize="12" />
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#F0F0F0" />
                                        <TextBlock Text="{Binding TriangleCount, StringFormat=' ({0} tris)'}" FontSize="10" Foreground="#888888" VerticalAlignment="Center" />
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </TabItem>

                    <TabItem Header="Bones" Foreground="#E0E0E0">
                        <TreeView ItemsSource="{Binding Skeletons.RootBones}"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Foreground="#E0E0E0"
                                  Padding="4">
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal" Margin="2">
                                        <TextBlock Text="🦴 " FontSize="12" />
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#FF7675" />
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </TabItem>
                </TabControl>

                <GridSplitter Grid.Row="2" Height="4" HorizontalAlignment="Stretch" Background="#2A2A36" />

                <!-- Object Inspector -->
                <Border Grid.Row="3" Background="#16161E" BorderBrush="#2A2A36" BorderThickness="0,1,0,0" Padding="12,10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="OBJECT INSPECTOR" FontSize="12" FontWeight="Bold" Foreground="#00CEC9" Margin="0,0,0,8" />

                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Name:" Foreground="#888888" FontSize="11" />
                                <TextBlock Grid.Column="1" Text="{Binding Inspector.ElementName}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11" />
                            </Grid>

                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Type:" Foreground="#888888" FontSize="11" />
                                <TextBlock Grid.Column="1" Text="{Binding Inspector.ElementType}" Foreground="#A29BFE" FontSize="11" />
                            </Grid>

                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Center:" Foreground="#888888" FontSize="11" />
                                <TextBlock Grid.Column="1" Text="{Binding Inspector.PositionDisplay}" Foreground="#E0E0E0" FontFamily="Consolas" FontSize="10" />
                            </Grid>

                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Size:" Foreground="#888888" FontSize="11" />
                                <TextBlock Grid.Column="1" Text="{Binding Inspector.BoundsSizeDisplay}" Foreground="#E0E0E0" FontFamily="Consolas" FontSize="10" />
                            </Grid>

                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Triangles:" Foreground="#888888" FontSize="11" />
                                <TextBlock Grid.Column="1" Text="{Binding Inspector.TriangleCount, StringFormat='{}{0:N0}'}" Foreground="#55EFC4" FontSize="11" />
                            </Grid>

                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Voxels:" Foreground="#888888" FontSize="11" />
                                <TextBlock Grid.Column="1" Text="{Binding Inspector.VoxelCount, StringFormat='{}{0:N0}'}" Foreground="#FFEAA7" FontSize="11" />
                            </Grid>

                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Material:" Foreground="#888888" FontSize="11" />
                                <TextBlock Grid.Column="1" Text="{Binding Inspector.MaterialName}" Foreground="#DFE6E9" FontSize="11" />
                            </Grid>

                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Texture:" Foreground="#888888" FontSize="11" />
                                <TextBlock Grid.Column="1" Text="{Binding Inspector.TextureSummary}" Foreground="#DFE6E9" FontSize="11" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>

        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#2A2A36" />

        <!-- RIGHT VIEWPORT AREA -->
        <Grid Grid.Column="2">
            <!-- 3D Viewport Control -->
            <controls:Viewport3DControl x:Name="Viewport3D"
                                        Scene="{Binding Scene}" />

            <!-- Floating Topbar Overlay: View presets & Modes -->
            <Border Background="#CC181820"
                    BorderBrush="#33FFFFFF"
                    BorderThickness="1"
                    CornerRadius="6"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="16"
                    Padding="8,4">
                <StackPanel Orientation="Horizontal">
                    <!-- Presets -->
                    <Button Content="Reset" Command="{Binding Camera.ResetCameraCommand}" Margin="2,0" Padding="8,4" Background="#282834" Foreground="#FFFFFF" BorderThickness="0" ToolTip="Reset Camera (R)" />
                    <Button Content="Front" Command="{Binding Camera.SetPresetCommand}" CommandParameter="{x:Static contracts:CameraPresetView.Front}" Margin="2,0" Padding="8,4" Background="#282834" Foreground="#FFFFFF" BorderThickness="0" ToolTip="Front View (1)" />
                    <Button Content="Right" Command="{Binding Camera.SetPresetCommand}" CommandParameter="{x:Static contracts:CameraPresetView.Right}" Margin="2,0" Padding="8,4" Background="#282834" Foreground="#FFFFFF" BorderThickness="0" ToolTip="Right View (4)" />
                    <Button Content="Top" Command="{Binding Camera.SetPresetCommand}" CommandParameter="{x:Static contracts:CameraPresetView.Top}" Margin="2,0" Padding="8,4" Background="#282834" Foreground="#FFFFFF" BorderThickness="0" ToolTip="Top View (5)" />
                    <Button Content="Iso" Command="{Binding Camera.SetPresetCommand}" CommandParameter="{x:Static contracts:CameraPresetView.Isometric}" Margin="2,0" Padding="8,4" Background="#282834" Foreground="#FFFFFF" BorderThickness="0" ToolTip="Isometric View" />

                    <Separator Width="1" Background="#44FFFFFF" Margin="6,2" />

                    <!-- Projection -->
                    <Button Content="Ortho / Persp" Command="{Binding Camera.ToggleProjectionCommand}" Margin="2,0" Padding="8,4" Background="#282834" Foreground="#6C5CE7" BorderThickness="0" ToolTip="Toggle Perspective / Orthographic projection" />

                    <Separator Width="1" Background="#44FFFFFF" Margin="6,2" />

                    <!-- Shading Presets -->
                    <Button Content="Studio" Command="{Binding Settings.ApplyPresetStudioCommand}" Margin="2,0" Padding="6,4" Background="#282834" Foreground="#FFFFFF" BorderThickness="0" />
                    <Button Content="Solid" Command="{Binding Settings.ApplyPresetNeutralCommand}" Margin="2,0" Padding="6,4" Background="#282834" Foreground="#FFFFFF" BorderThickness="0" />
                    <Button Content="Wire" Command="{Binding Settings.ApplyPresetWireframeCommand}" Margin="2,0" Padding="6,4" Background="#282834" Foreground="#FFFFFF" BorderThickness="0" />

                    <Separator Width="1" Background="#44FFFFFF" Margin="6,2" />

                    <!-- Toggles -->
                    <CheckBox Content="Grid" IsChecked="{Binding Settings.ShowGrid}" Foreground="#E0E0E0" VerticalAlignment="Center" Margin="4,0" />
                    <CheckBox Content="Axes" IsChecked="{Binding Settings.ShowAxes}" Foreground="#E0E0E0" VerticalAlignment="Center" Margin="4,0" />
                    <CheckBox Content="Bounds" IsChecked="{Binding Settings.ShowBoundingBox}" Foreground="#E0E0E0" VerticalAlignment="Center" Margin="4,0" />
                    <CheckBox Content="Normals" IsChecked="{Binding Settings.ShowNormals}" Foreground="#E0E0E0" VerticalAlignment="Center" Margin="4,0" />
                    <CheckBox Content="Bones" IsChecked="{Binding Settings.ShowBones}" Foreground="#E0E0E0" VerticalAlignment="Center" Margin="4,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
