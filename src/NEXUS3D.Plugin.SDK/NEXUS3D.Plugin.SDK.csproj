<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>NEXUS3D.Plugin.SDK</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <PackageId>NEXUS3D.Plugin.SDK</PackageId>
    <Version>1.0.0</Version>
    <Authors>ManhCuong-Code</Authors>
    <Description>Software Development Kit for building NEXUS-3D plugins, custom 3D parsers, exporters, and format extensions.</Description>
    <PackageTags>3d;converter;voxel;minecraft;schematic;obj;plugin;sdk</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/ManhCuong-Code/NEXUS-3D.git</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NEXUS3D.Domain\NEXUS3D.Domain.csproj" />
    <ProjectReference Include="..\NEXUS3D.Formats.Abstractions\NEXUS3D.Formats.Abstractions.csproj" />
    <ProjectReference Include="..\NEXUS3D.Shared\NEXUS3D.Shared.csproj" />
  </ItemGroup>

</Project>
